{
  "name": "gruvbox-material-custom",
  "displayName": "Gruvbox Material Dark Custom",
  "description": "Personal variant of Gruvbox Material Dark with custom workbench and token colors",
  "version": "1.0.4",
  "publisher": "stratovarius93",
  "author": "Stratovarius93",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stratovarius93/gruvbox-material-custom.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gruvbox",
    "gruvbox-material",
    "theme",
    "dark"
  ],
  "galleryBanner": {
    "color": "#282828",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Gruvbox Material Dark Custom",
        "uiTheme": "vs-dark",
        "path": "./themes/gruvbox-material-dark-custom.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "dart",
        "scopes": {
          "string": [
            "meta.semantic-string.dart"
          ]
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js",
    "package": "npm run build && npx --yes @vscode/vsce package --allow-missing-repository"
  }
}

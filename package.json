{
  "name": "gruvbox-flutter-theme",
  "displayName": "Gruvbox Flutter Theme",
  "description": "Gruvbox Material Dark variant tuned for Flutter/Dart, with custom workbench and token colors, plus bundled Gruvbox Material file icons",
  "version": "1.2.0",
  "publisher": "stratovarius93",
  "author": "Stratovarius93",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stratovarius93/gruvbox-flutter-theme.git"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gruvbox",
    "gruvbox-material",
    "flutter",
    "dart",
    "theme",
    "dark",
    "icons",
    "icon-theme"
  ],
  "galleryBanner": {
    "color": "#282828",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Gruvbox Flutter Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/gruvbox-flutter-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "gruvbox-flutter-icons",
        "label": "Gruvbox Flutter Icons",
        "path": "./iconthemes/gruvbox-material-icons.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js",
    "package": "npm run build && npx --yes @vscode/vsce package --allow-missing-repository"
  }
}

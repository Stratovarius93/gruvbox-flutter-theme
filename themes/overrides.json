  "tokenColors": [
    {
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter",
        "variable.parameter.dart"
      ],
      "settings": {
        "foreground": "#f2e7ca"
      }
    },
    {
      "scope": [
        "string.interpolated.single.dart",
        "string.interpolated.double.dart"
      ],
      "settings": {
        "foreground": "#d8a657"
      }
    },
    {
      "name": "Dart: classes/types match semantic class color",
      "scope": [
        "support.class.dart"
      ],
      "settings": {
        "foreground": "#7daea3"
      }
    },
    {
      "name": "Dart: this/super and modifiers match semantic keyword color",
      "scope": [
        "variable.language.dart",
        "storage.modifier.dart",
        "storage.type.primitive.dart"
      ],
      "settings": {
        "foreground": "#ea6962"
      }
    },
    {
      "name": "Dart: plain identifiers (variables, params, properties)",
      "scope": [
        "source.dart"
      ],
      "settings": {
        "foreground": "#f2e7ca"
      }
    },
    {
      "name": "Dart: annotations match semantic annotation color",
      "scope": [
        "storage.type.annotation.dart"
      ],
      "settings": {
        "foreground": "#d4be98"
      }
    },
    {
      "name": "Dart: doc comment references match semantic function color",
      "scope": [
        "variable.name.source.dart"
      ],
      "settings": {
        "foreground": "#a9b665"
      }
    },
    {
      "name": "Dart: import/export URIs in green",
      "scope": [
        "meta.declaration.dart string.interpolated.single.dart",
        "meta.declaration.dart string.interpolated.double.dart",
        "meta.declaration.dart string.quoted.single.dart",
        "meta.declaration.dart string.quoted.double.dart"
      ],
      "settings": {
        "foreground": "#a9b665"
      }
    }
  ],
  "replaceScopes": {
    "string": [
      "string.quoted",
      "string.unquoted",
      "string.interpolated",
      "string.template",
      "string.regexp",
      "string.other",
      "string.definition",
      "string.json",
      "string.tag",
      "string.docstring",
      "string.key",
      "string.heredoc"
    ],
    "keyword": [
      "source keyword",
      "text keyword"
    ]
  },
  "_comment_replaceScopes": "The generic 'string' selector is what semantic 'string' tokens resolve to. Replacing it with specific selectors keeps every grammar string yellow but lets Dart semantic strings keep grammar colors (green import URIs). Same for \"keyword\": with a parent selector, semantic keyword tokens (Dart LSP marks import/class/final/... alike) no longer override the grammar color, so `import` stays fuchsia."
}
